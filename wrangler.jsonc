{
  "name": "composer-state",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "routes": [
    {
      "pattern": "ai.loftwah.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "preview_urls": false
}